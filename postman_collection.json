{
	"info": {
		"_postman_id": "student-event-dashboard-api-v1",
		"name": "Student Event Management & Analytics Platform API",
		"description": "Complete REST API collection for Admin, Organizer, and Student roles.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login (Admin)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@college.edu\",\n  \"password\": \"Password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "Login (Student)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"liam.chen@student.college.edu\",\n  \"password\": \"Password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "Register Student",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Emma Davis\",\n  \"email\": \"emma.d@student.college.edu\",\n  \"password\": \"Password123\",\n  \"role\": \"student\",\n  \"department_id\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "register"]
						}
					}
				}
			]
		},
		{
			"name": "Events",
			"item": [
				{
					"name": "Get All Events (Filtered)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/events?category=Hackathon",
							"host": ["{{baseUrl}}"],
							"path": ["api", "events"],
							"query": [{ "key": "category", "value": "Hackathon" }]
						}
					}
				},
				{
					"name": "Create Event (Organizer)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Cloud Computing & DevOps Masterclass\",\n  \"description\": \"Learn AWS, Docker, Kubernetes and CI/CD pipelines.\",\n  \"category\": \"Workshop\",\n  \"location\": \"IT Auditorium B\",\n  \"start_time\": \"2026-09-10T10:00:00Z\",\n  \"end_time\": \"2026-09-10T16:00:00Z\",\n  \"capacity\": 100\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/events",
							"host": ["{{baseUrl}}"],
							"path": ["api", "events"]
						}
					}
				}
			]
		},
		{
			"name": "Analytics",
			"item": [
				{
					"name": "Get Dashboard Analytics",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/analytics",
							"host": ["{{baseUrl}}"],
							"path": ["api", "analytics"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:5000" },
		{ "key": "jwtToken", "value": "" }
	]
}
